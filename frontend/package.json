{
  "name": "sms-eduportal-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/v6-api.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:legacy": "node --test tests/access-policy.test.mjs tests/campus-posts.test.mjs tests/presentation-copy.test.mjs tests/workflows.test.mjs",
    "test:browser:legacy": "node tests/browser-smoke.mjs",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run test && vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/junit.xml"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  }
}
