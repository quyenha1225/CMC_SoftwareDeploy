{
 "uid": "sms-infra",
 "title": "SMS infrastructure",
 "tags": [
  "sms"
 ],
 "schemaVersion": 39,
 "version": 3,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Frontend /healthz",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_success{job=\"sms-frontend-probe\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Backend",
   "datasource": {
    "type": "prometheus"
   },
