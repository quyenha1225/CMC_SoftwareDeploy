  {
   "id": 14,
   "type": "stat",
   "title": "Monitoring targets",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=~\"sms-monitoring|sms-node|sms-cadvisor\"}",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
