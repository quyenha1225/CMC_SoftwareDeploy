  {
   "id": 3,
   "type": "gauge",
   "title": "Ổ đĩa Docker trống (%)",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * min(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Frontend latency",
   "datasource": {
    "type": "prometheus"
   },
   "gridPos": {
    "x": 12,
