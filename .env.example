# Non-secret Docker configuration. Generate the single local .env with scripts/docker.py init.
COMPOSE_PROJECT_NAME=sms_local
APP_PORT=8088
APP_BIND=127.0.0.1
DB_NAME=sms_db
TZ=Asia/Ho_Chi_Minh
SMS_PUBLIC_URL=http://localhost:8088
SESSION_SECURE=false
SMS_SEED_DEMO=true
SMS_BOOTSTRAP_ENABLED=false
SMS_BOOTSTRAP_USERNAME=principal
SMS_BOOTSTRAP_EMAIL=principal@example.test
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
# For staging/prod use compose.prod.yaml, no demo seed, HTTPS and immutable image digests.

# Optional non-secret application settings; SMTP password stays in .secrets/smtp_password.
SMS_MAIL_ENABLED=false
SMS_OUTBOX_ENABLED=false
SMS_SMTP_USERNAME=
SMS_SMTP_HOST=smtp.gmail.com
SMS_SMTP_PORT=587
SMS_SMTP_TIMEOUT_MS=5000
SMS_SCHOOL_EMAIL_DOMAIN=student.campus.edu.vn
SMS_JWT_TTL_SECONDS=1800
SESSION_TIMEOUT=30m
SMS_OUTBOX_DELAY_MS=30000
SMS_MAX_FILE_SIZE=5MB
SMS_MAX_REQUEST_SIZE=20MB
